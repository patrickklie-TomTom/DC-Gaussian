    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Train DC-Gaussian",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "-s", "${env:dataset}",
                "-m", "${env:output}",
                "--eval",
                "-r", "1",
                "--win_type", "iom",
                "--position_lr_init", "0.00008",
                "--position_lr_final", "0.000008",
                "--scaling_lr", "0.005",
                "--percent_dense", "0.0005",
                "--densify_until_iter", "20000"
            ],
            "console": "integratedTerminal",
            "env": {
                "dataset": "${env:HOME}/data/input/bdd100k/bdd100k_1/",
                "output": "${env:HOME}/dev/github/patrickklie-TomTom/wth2025-gaussian-splatting-from-dashcams/external/DC-Gaussian/output"
            },
            "python": "/home/califauser/.conda/envs/dcgaussian2/bin/python", 
            "justMyCode": true
        }
    ]
}